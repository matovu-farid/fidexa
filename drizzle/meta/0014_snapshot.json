        "campaign_observations_source_check": {
          "name": "campaign_observations_source_check",
          "value": "\"campaign_observations\".\"source\" = 'manual_zoho_browser'"
        },
        "campaign_observations_event_type_check": {
          "name": "campaign_observations_event_type_check",
          "value": "\"campaign_observations\".\"event_type\" IN ('approved_variant', 'sent', 'delivered', 'bounce', 'reply', 'qualified_reply', 'opt_out', 'booked', 'attended', 'follow_up', 'close_out', 'response_check')"
        },
        "campaign_observations_outcome_check": {
          "name": "campaign_observations_outcome_check",
          "value": "\"campaign_observations\".\"outcome\" IN ('verified', 'no_reply_observed', 'unavailable', 'unverified')"
        },
        "campaign_observations_attribution_check": {
          "name": "campaign_observations_attribution_check",
          "value": "\"campaign_observations\".\"attribution\" IN ('attributable', 'unattributed', 'unknown')"
        },
        "campaign_observations_quantity_check": {
          "name": "campaign_observations_quantity_check",
          "value": "\"campaign_observations\".\"quantity\" BETWEEN 0 AND 10000"
        },
        "campaign_observations_no_reply_folders_check": {
          "name": "campaign_observations_no_reply_folders_check",
          "value": "\"campaign_observations\".\"outcome\" <> 'no_reply_observed' OR (\"campaign_observations\".\"event_type\" = 'response_check' AND \"campaign_observations\".\"checked_folders\" ?& ARRAY['inbox', 'spam'])"
        },
        "campaign_observations_no_reply_sent_set_check": {
          "name": "campaign_observations_no_reply_sent_set_check",
          "value": "\"campaign_observations\".\"outcome\" <> 'no_reply_observed' OR (\"campaign_observations\".\"checked_folders\" ? 'sent' AND jsonb_array_length(\"campaign_observations\".\"checked_sent_observation_ids\") > 0)"
        },
        "campaign_observations_approved_variant_check": {
          "name": "campaign_observations_approved_variant_check",
          "value": "\"campaign_observations\".\"event_type\" <> 'approved_variant' OR (\"campaign_observations\".\"outcome\" = 'verified' AND \"campaign_observations\".\"attribution\" = 'unknown' AND \"campaign_observations\".\"quantity\" = 0 AND \"campaign_observations\".\"visible_message_id\" IS NOT NULL AND \"campaign_observations\".\"variant_id\" IS NOT NULL AND \"campaign_observations\".\"variant_id\" ~ '^[A-Fa-f0-9]{64}$' AND \"campaign_observations\".\"note\" IS NOT NULL)"
        },
        "campaign_observations_verified_sent_check": {
          "name": "campaign_observations_verified_sent_check",
          "value": "\"campaign_observations\".\"event_type\" <> 'sent' OR \"campaign_observations\".\"outcome\" <> 'verified' OR (\"campaign_observations\".\"visible_message_id\" IS NOT NULL AND \"campaign_observations\".\"variant_id\" IS NOT NULL AND \"campaign_observations\".\"variant_id\" ~ '^[A-Fa-f0-9]{64}$')"
        },
        "campaign_observations_attribution_ref_check": {
